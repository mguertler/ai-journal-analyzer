class AnalyzerError(Exception):
    """Raised for expected runtime errors."""


class EmptyAIResponseError(AnalyzerError):
    """Raised when the API returned JSON but no usable text content."""


def deep_merge(base: Dict[str, Any], override: Dict[str, Any]) -> Dict[str, Any]:
    result = copy.deepcopy(base)
    for key, value in override.items():
        if isinstance(value, dict) and isinstance(result.get(key), dict):
            result[key] = deep_merge(result[key], value)
        else:
            result[key] = value
    return result



def get_nested(mapping: Dict[str, Any], parts: Sequence[str]) -> Any:
    current: Any = mapping
    for part in parts:
        if not isinstance(current, dict) or part not in current:
            return None
        current = current[part]
    return current


def set_nested(mapping: Dict[str, Any], parts: Sequence[str], value: Any) -> None:
    current = mapping
    for part in parts[:-1]:
        next_value = current.get(part)
        if not isinstance(next_value, dict):
            next_value = {}
            current[part] = next_value
        current = next_value
    current[parts[-1]] = value


def strip_inline_comment(value: str) -> str:
    quote: Optional[str] = None
    escaped = False
    for idx, char in enumerate(value):
        if escaped:
            escaped = False
            continue
        if char == "\\":
            escaped = True
            continue
        if quote:
            if char == quote:
                quote = None
            continue
        if char in {"'", '"'}:
            quote = char
            continue
        if char in {"#", ";"} and (idx == 0 or value[idx - 1].isspace()):
            return value[:idx].rstrip()
    return value.strip()


def unquote(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
        inner = value[1:-1]
        if value[0] == '"':
            try:
                return bytes(inner, "utf-8").decode("unicode_escape")
            except UnicodeDecodeError:
                return inner
        return inner
    return value


def parse_bool(value: str) -> bool:
    lowered = value.strip().lower()
    if lowered in {"1", "true", "yes", "y", "on", "enabled"}:
        return True
    if lowered in {"0", "false", "no", "n", "off", "disabled"}:
        return False
    raise AnalyzerError(f"Invalid boolean value: {value!r}")


def cast_config_value(key: str, raw_value: str) -> Any:
    parts = key.split(".")
    default_value = get_nested(DEFAULT_CONFIG, parts)
    value = unquote(strip_inline_comment(raw_value))

    if isinstance(default_value, bool):
        return parse_bool(value)
    if isinstance(default_value, int) and not isinstance(default_value, bool):
        try:
            return int(value)
        except ValueError as exc:
            raise AnalyzerError(f"Invalid integer for {key}: {value!r}") from exc
    if isinstance(default_value, float):
        try:
            return float(value)
        except ValueError as exc:
            raise AnalyzerError(f"Invalid float for {key}: {value!r}") from exc
    if isinstance(default_value, dict):
        if value in {"", "{}"}:
            return {}
        try:
            parsed = json.loads(value)
        except json.JSONDecodeError as exc:
            raise AnalyzerError(f"Dictionary value for {key} must be JSON, e.g. {{\"Header\":\"Value\"}}") from exc
        if not isinstance(parsed, dict):
            raise AnalyzerError(f"Dictionary value for {key} must be a JSON object.")
        return parsed

    # For unknown keys, infer only simple scalar types. This keeps custom headers such as
    # openai.extra_headers.X-Header readable without requiring JSON.
    lowered = value.lower()
    if lowered in {"true", "false", "yes", "no", "on", "off"}:
        return parse_bool(value)
    if re.fullmatch(r"[-+]?\d+", value):
        try:
            return int(value)
        except ValueError:
            pass
    if re.fullmatch(r"[-+]?(\d+\.\d*|\d*\.\d+)", value):
        try:
            return float(value)
        except ValueError:
            pass
    return value


def apply_config_assignment(loaded: Dict[str, Any], key: str, raw_value: str) -> None:
    key = key.strip()
    if not key or not re.fullmatch(r"[A-Za-z0-9_.-]+", key):
        raise AnalyzerError(f"Invalid config key: {key!r}")
    parts = key.split(".")
    default_value = get_nested(DEFAULT_CONFIG, parts)

    if isinstance(default_value, list):
        value = unquote(strip_inline_comment(raw_value))
        existing = get_nested(loaded, parts)
        if value.strip() in {"", "[]"}:
            set_nested(loaded, parts, [])
            return
        if not isinstance(existing, list):
            existing = []
            set_nested(loaded, parts, existing)
        existing.append(value)
        return

    set_nested(loaded, parts, cast_config_value(key, raw_value))


def parse_key_value_config(path: Path) -> Dict[str, Any]:
    loaded: Dict[str, Any] = {}
    lines = path.read_text(encoding="utf-8").splitlines()
    idx = 0
    while idx < len(lines):
        raw_line = lines[idx]
        idx += 1
        stripped = raw_line.strip()
        if not stripped or stripped.startswith("#") or stripped.startswith(";"):
            continue

        heredoc_match = re.match(r"^([A-Za-z0-9_.-]+)\s*<<\s*['\"]?([A-Za-z0-9_-]+)['\"]?\s*$", stripped)
        if heredoc_match:
            key, marker = heredoc_match.groups()
            value_lines: List[str] = []
            while idx < len(lines):
                candidate = lines[idx]
                idx += 1
                if candidate.strip() == marker:
                    break
                value_lines.append(candidate)
            else:
                raise AnalyzerError(f"Unterminated heredoc for config key {key}; missing marker {marker}.")
            if not re.fullmatch(r"[A-Za-z0-9_.-]+", key):
                raise AnalyzerError(f"Invalid config key: {key!r}")
            set_nested(loaded, key.split("."), "\n".join(value_lines))
            continue

        if "=" not in raw_line:
            raise AnalyzerError(f"Invalid config line {idx}: expected key = value.")
        key, value = raw_line.split("=", 1)
        apply_config_assignment(loaded, key, value)
    return loaded


def load_json_config_file(path: Path) -> Dict[str, Any]:
    try:
        with path.open("r", encoding="utf-8") as handle:
            loaded = json.load(handle)
    except json.JSONDecodeError as exc:
        raise AnalyzerError(f"Invalid JSON in config file {path}: {exc}") from exc
    if not isinstance(loaded, dict):
        raise AnalyzerError(f"Config file {path} must contain a JSON object.")
    return loaded


def load_config(path: Path) -> Dict[str, Any]:
    try:
        if path.suffix.lower() == ".json":
            loaded = load_json_config_file(path)
        else:
            loaded = parse_key_value_config(path)
    except FileNotFoundError as exc:
        raise AnalyzerError(missing_config_message(path)) from exc
    if not isinstance(loaded, dict):
        raise AnalyzerError(f"Config file {path} did not produce a configuration object.")
    return deep_merge(DEFAULT_CONFIG, loaded)



def normalize_api_url(api_url: str, api_path: str) -> str:
    """Return the full API endpoint from a base URL and endpoint path.

    `api_url` is intentionally treated as a base URL for user clarity. For
    backward compatibility, a full legacy endpoint such as
    https://api.openai.com/v1/chat/completions is accepted unchanged when
    api_path is empty.
    """
    url = str(api_url or "").strip().rstrip("/")
    path = str(api_path or "").strip()
    if not url:
        raise AnalyzerError("openai.api_url / --api-url must not be empty.")
    # Backward compatibility for older configs where api_url contained the full endpoint.
    if re.search(r"/v\d+/(responses|chat/completions)$", url):
        return url
    if not path:
        return url
    if not path.startswith("/"):
        path = "/" + path
    return url + path


def getenv_or_config(config: Dict[str, Any], section: str, key: str, env_name: str = "") -> str:
    if env_name:
        env_value = os.environ.get(env_name, "")
        if env_value:
            return env_value
    value = config.get(section, {}).get(key, "")
    return str(value) if value is not None else ""


def ascii_text(text: str) -> str:
    return text.encode("ascii", "replace").decode("ascii")


def split_config_list(value: Any) -> List[str]:
    """Parse empty, comma-separated, repeated-key, or heredoc config values."""
    if value is None:
        return []
    if isinstance(value, list):
        items: List[str] = []
        for item in value:
            items.extend(split_config_list(item))
        return items
    text = str(value).strip()
    if not text:
        return []
    items = []
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        # Comma-separated values are intended for simple patterns/topics.
        # Regexes containing commas should be configured via heredoc, one per line.
        items.extend(part.strip() for part in line.split(",") if part.strip())
    return items


def build_journal_command(args: argparse.Namespace, config: Dict[str, Any]) -> List[str]:
    command = ["journalctl", "--since", args.since, "-p", args.loglevel, "--no-pager", "-o", "short-iso"]
    if args.until:
        command.extend(["--until", args.until])
    for identifier in split_config_list(args.syslog_identifier):
        command.append(f"SYSLOG_IDENTIFIER={identifier}")
    if args.sudo and os.geteuid() != 0:
        command.insert(0, "sudo")
    return command


def should_exclude(line: str, patterns: Sequence[str]) -> bool:
    for pattern in patterns:
        if not pattern:
            continue
        try:
            if re.search(pattern, line):
                return True
        except re.error:
            if pattern in line:
                return True
    return False


def collect_from_input_file(input_file: str, patterns: Sequence[str]) -> Tuple[Path, int]:
    temp = tempfile.NamedTemporaryFile("w", encoding="utf-8", delete=False, prefix="journal-ai-", suffix=".log")
    count = 0
    temp_path = Path(temp.name)
    try:
        with open(input_file, "r", encoding="utf-8", errors="replace") as src, temp:
            for raw_line in src:
                if should_exclude(raw_line, patterns):
                    continue
                temp.write(raw_line)
                count += 1
    except Exception:
        try:
            temp_path.unlink(missing_ok=True)
        finally:
            raise
    return temp_path, count


def collect_journal(command: Sequence[str], patterns: Sequence[str]) -> Tuple[Path, int]:
    temp = tempfile.NamedTemporaryFile("w", encoding="utf-8", delete=False, prefix="journal-ai-", suffix=".log")
    temp_path = Path(temp.name)
    count = 0
    try:
        process = subprocess.Popen(
            list(command),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            encoding="utf-8",
            errors="replace",
        )
        assert process.stdout is not None
        with temp:
            for line in process.stdout:
                if should_exclude(line, patterns):
                    continue
                temp.write(line)
                count += 1
        stderr = process.stderr.read() if process.stderr else ""
        return_code = process.wait()
    except FileNotFoundError as exc:
        temp_path.unlink(missing_ok=True)
        raise AnalyzerError("journalctl was not found. This script must run on a systemd-based Linux host.") from exc
    except Exception:
        temp_path.unlink(missing_ok=True)
        raise

    if return_code != 0:
        temp_path.unlink(missing_ok=True)
        raise AnalyzerError(f"journalctl failed with exit code {return_code}: {stderr.strip()}")
    return temp_path, count


def iter_chunks(path: Path, chunk_size: int) -> Iterator[List[str]]:
    if chunk_size <= 0:
        raise AnalyzerError("--chunksize must be greater than zero.")
    with path.open("r", encoding="utf-8", errors="replace") as handle:
        chunk: List[str] = []
        for line in handle:
            chunk.append(line.rstrip("\n"))
            if len(chunk) >= chunk_size:
                yield chunk
                chunk = []
        if chunk:
            yield chunk


def print_journal_file(path: Path) -> None:
    with path.open("r", encoding="utf-8", errors="replace") as handle:
        for line in handle:
            print(line, end="")


def progress_bar(current: int, total: int, width: int = 36) -> str:
    if total <= 0:
        return "[" + "." * width + "] 0%"
    ratio = min(max(current / total, 0.0), 1.0)
    filled = int(round(width * ratio))
    return f"[{'#' * filled}{'.' * (width - filled)}] {ratio * 100:5.1f}% ({current}/{total})"


def write_progress(current: int, total: int, enabled: bool) -> None:
    if not enabled:
        return
    sys.stderr.write("\r" + progress_bar(current, total))
    sys.stderr.flush()
    if current >= total:
        sys.stderr.write("\n")
        sys.stderr.flush()


def build_chat_payload(config: Dict[str, Any], model: str, system_prompt: str, user_prompt: str) -> Dict[str, Any]:
    openai_cfg = config["openai"]
    payload: Dict[str, Any] = {
        "model": model,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt},
        ],
    }
    if openai_cfg.get("temperature") is not None:
        payload["temperature"] = openai_cfg.get("temperature")
    max_output_tokens = openai_cfg.get("max_output_tokens")
    if max_output_tokens is not None:
        payload[str(openai_cfg.get("max_tokens_field", "max_tokens"))] = int(max_output_tokens)
    return payload


def build_responses_payload(config: Dict[str, Any], model: str, system_prompt: str, user_prompt: str) -> Dict[str, Any]:
    openai_cfg = config["openai"]
    payload: Dict[str, Any] = {
        "model": model,
        "instructions": system_prompt,
        "input": user_prompt,
    }
    if openai_cfg.get("temperature") is not None:
        payload["temperature"] = openai_cfg.get("temperature")
    max_output_tokens = openai_cfg.get("max_output_tokens")
    if max_output_tokens is not None:
        payload["max_output_tokens"] = int(max_output_tokens)
    return payload


def extract_response_text(data: Dict[str, Any], api_style: str) -> str:
    if api_style == "responses":
        if isinstance(data.get("output_text"), str):
            return data["output_text"]
        parts: List[str] = []
        for item in data.get("output", []) or []:
            for content in item.get("content", []) or []:
                if isinstance(content.get("text"), str):
                    parts.append(content["text"])
                elif isinstance(content.get("text"), dict) and isinstance(content["text"].get("value"), str):
                    parts.append(content["text"]["value"])
        if parts:
            return "\n".join(parts)
    choices = data.get("choices", [])
    if choices:
        first = choices[0]
        message = first.get("message", {})
        content = message.get("content")
        if isinstance(content, str):
            return content
        if isinstance(content, list):
            parts = []
            for item in content:
                if isinstance(item, dict):
                    if isinstance(item.get("text"), str):
                        parts.append(item["text"])
                    elif isinstance(item.get("content"), str):
                        parts.append(item["content"])
            if parts:
                return "\n".join(parts)
        if isinstance(first.get("text"), str):
            return first["text"]
    raise AnalyzerError("Could not extract text from API response.")


def call_ai(config: Dict[str, Any], args: argparse.Namespace, system_prompt: str, user_prompt: str) -> str:
    if args.mock_ai:
        return mock_ai_response(system_prompt, user_prompt)

    api_style = args.api_style
    api_url = normalize_api_url(args.api_url, args.api_path)
    api_key = os.environ.get("OPENAI_API_KEY") or str(config["openai"].get("api_key", ""))
    headers = {"Content-Type": "application/json"}
    if api_key and api_key.strip() and api_key.strip() not in {"YOUR_KEY", "YOUR_OPENAI_API_KEY"}:
        headers["Authorization"] = f"Bearer {api_key.strip()}"
    headers.update({str(k): str(v) for k, v in (config["openai"].get("extra_headers") or {}).items()})

    if api_style == "responses":
        payload = build_responses_payload(config, args.model, system_prompt, user_prompt)
    else:
        payload = build_chat_payload(config, args.model, system_prompt, user_prompt)

    body = json.dumps(payload).encode("utf-8")
    timeout = int(config["openai"].get("timeout_seconds", 120))
    max_retries = max(0, int(config["openai"].get("max_retries", 1)))
    total_attempts = 1 + max_retries
    backoff = float(config["openai"].get("retry_backoff_seconds", 2))

    last_error: Optional[Exception] = None
    for attempt in range(1, total_attempts + 1):
        request = urllib.request.Request(api_url, data=body, headers=headers, method="POST")
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                response_body = response.read().decode("utf-8", errors="replace")
            data = json.loads(response_body)
            text = ascii_text(extract_response_text(data, api_style))
            if not text.strip():
                raise EmptyAIResponseError("API returned an empty response text.")
            return text
        except urllib.error.HTTPError as exc:
            error_body = exc.read().decode("utf-8", errors="replace")
            last_error = AnalyzerError(f"API HTTP {exc.code}: {error_body[:2000]}")
            if exc.code not in {408, 409, 425, 429, 500, 502, 503, 504}:
                break
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, AnalyzerError) as exc:
            last_error = exc
        if attempt < total_attempts:
            time.sleep(backoff * attempt)
    if isinstance(last_error, EmptyAIResponseError):
        raise AnalyzerError(
            "The AI model returned no usable text after "
            f"{total_attempts} API attempt(s).\n\n"
            "This often means the model/context window failed or the proxy returned no content.\n"
            "Try these steps:\n"
            f"  1. Reduce journal.chunksize. Current value: {args.chunksize} lines.\n"
            "  2. Increase openai.max_output_tokens if the model is likely truncating the answer. "
            f"Current value: {config['openai'].get('max_output_tokens', '')}.\n"
            "  3. If you use Ollama or LiteLLM, check the model context size and proxy logs.\n"
            "  4. Try a smaller time range with --since.\n\n"
            "The current chunk was not analyzed. Aborting to avoid an incomplete report."
        )
    raise AnalyzerError(f"API request failed after {total_attempts} attempt(s): {last_error}")


def mock_ai_response(system_prompt: str, user_prompt: str) -> str:
    # This is intentionally simple and is only for local smoke tests.
    timestamp_mode = "Timestamp mode is enabled" in system_prompt
    if "chunk analyses" in user_prompt.lower() or "prioritized" in user_prompt.lower():
        findings = [line for line in user_prompt.splitlines() if line.startswith("* Error:")]
        timestamps = [line for line in user_prompt.splitlines() if line.startswith("* Timestamps:")]
        if not findings:
            return "Summary\n-------\nNo actionable errors found.\n\nPriority 1 - Fix soon\n---------------------\nNone."
        timestamp_note = ""
        if timestamp_mode and timestamps:
            timestamp_note = f"\nExample timestamps: {timestamps[-1].split(':', 1)[1].strip()}"
        return (
            "Summary\n-------\nActionable journal events were found.\n\n"
            "Priority 1 - Fix soon\n---------------------\nReview the listed failed services or errors and inspect them with systemctl status and journalctl -u."
            f"{timestamp_note}\n"
        )
    errors = []
    for line in user_prompt.splitlines():
        if re.search(r"\b(error|failed|failure|critical|alert|denied|unauthorized|segfault|panic)\b", line, re.I):
            errors.append(line)
    if not errors:
        return "ok"
    deduped = list(dict.fromkeys(errors))[:20]
    rendered = []
    for line in deduped:
        ts_line = ""
        if timestamp_mode:
            timestamp = line.split(maxsplit=1)[0] if line else "unknown"
            ts_line = f"\n* Timestamps: {timestamp}"
        rendered.append(f"* Error: {line}{ts_line}\n* Explanation: Mock analysis: this line looks actionable and should be checked.")
    return "\n\n".join(rendered)



def timestamps_enabled(config: Dict[str, Any], args: argparse.Namespace) -> bool:
    if args.include_timestamps is not None:
        return bool(args.include_timestamps)
    return bool(config.get("timestamps", {}).get("enabled", False))


def build_timestamp_chunk_suffix(config: Dict[str, Any], args: argparse.Namespace) -> str:
    if not timestamps_enabled(config, args):
        return ""
    samples = max(1, int(args.timestamp_samples))
    marker = "and more"
    return f"""

Timestamp mode is enabled.
For every actionable error, include an additional line immediately after the Error line:
* Timestamps: <at least {samples} example journal timestamps when {samples} or more matching/repeated lines are available; prefer the latest timestamps toward the end of this chunk; append '{marker}' if more matching timestamps exist than are shown>

Use timestamps exactly as they appear at the beginning of journal lines. If fewer than {samples} matching timestamps are available, list all available timestamps. Keep the output ASCII only.
The per-error format must be:
* Error: <journal entry>
* Timestamps: <timestamp 1>, <timestamp 2>, <timestamp 3>[; {marker}]
* Explanation: <explain the error, likely impact, and what to check next>
"""


def build_timestamp_final_suffix(config: Dict[str, Any], args: argparse.Namespace) -> str:
    if not timestamps_enabled(config, args):
        return ""
    samples = max(1, int(args.timestamp_samples))
    marker = "and more"
    return f"""

Timestamp mode is enabled.
The chunk analyses may contain '* Timestamps:' lines. Preserve these timestamps in the final report.
For each report item, include a line named 'Example timestamps:' with at least {samples} representative timestamps when available, preferring the latest timestamps. Keep the marker '{marker}' when the chunk analysis indicates more occurrences.
Do not invent timestamps that are not present in the chunk analyses.
"""


def build_focus_and_ai_exclusion_suffix(config: Dict[str, Any], args: argparse.Namespace) -> str:
    parts: List[str] = []
    focus_on = str(getattr(args, "focus_on", "") or config.get("journal", {}).get("focus_on", "") or "").strip()
    if focus_on:
        parts.append(
            "Focus primarily on findings related to: "
            + focus_on
            + ". Only include unrelated issues if they are urgent security, data-loss, hardware, or service-failure events."
        )
    exclude_topics = split_config_list(config.get("journal", {}).get("exclude_ai_patterns", ""))
    if exclude_topics:
        rendered = "\n".join(f"- {topic}" for topic in exclude_topics)
        parts.append(
            "Ignore findings that only match these user-defined AI exclusion topics unless they indicate a severe security or data-loss risk:\n"
            + rendered
        )
    if not parts:
        return ""
    return "\n\nUser-defined analysis scope:\n" + "\n\n".join(parts) + "\n"


def get_chunk_system_prompt(config: Dict[str, Any], args: argparse.Namespace) -> str:
    return (
        str(config["prompts"]["chunk_system"])
        + build_focus_and_ai_exclusion_suffix(config, args)
        + build_timestamp_chunk_suffix(config, args)
    )


def get_final_system_prompt(config: Dict[str, Any], args: argparse.Namespace) -> str:
    return str(config["prompts"]["final_system"]) + build_timestamp_final_suffix(config, args)


def response_is_ok(text: str) -> bool:
    normalized = re.sub(r"[\s.!,;:]+", "", text.strip().lower())
    return normalized in {"ok", "okay"}



def analyze_chunks(config: Dict[str, Any], args: argparse.Namespace, journal_path: Path, line_count: int) -> List[str]:
    chunk_size = int(args.chunksize)
    total_chunks = max(1, math.ceil(line_count / chunk_size)) if line_count else 0
    results: List[str] = []
    prompts = config["prompts"]
    progress_enabled = bool(config["defaults"].get("progress", True)) and not args.no_progress
    if total_chunks > 0:
        write_progress(0, total_chunks, progress_enabled)

    chunk_system_prompt = get_chunk_system_prompt(config, args)
    for idx, chunk in enumerate(iter_chunks(journal_path, chunk_size), start=1):
        chunk_text = "\n".join(chunk)
        user_prompt = f"{prompts.get('chunk_user_prefix', '')}{chunk_text}"
        result = call_ai(config, args, chunk_system_prompt, user_prompt).strip()
        if not result:
            raise AnalyzerError(f"AI returned an empty result for chunk {idx}/{total_chunks}; aborting to avoid an incomplete report.")
        if args.debug_ai:
            state = "ok" if response_is_ok(result) else "finding"
            print(f"Debug: chunk {idx}/{total_chunks}: final AI result state = {state}", file=sys.stderr)
        if result:
            results.append(f"# Chunk {idx}/{total_chunks}\n{result}")
        write_progress(idx, total_chunks, progress_enabled)
    return results


def normalize_chunk_results(results: Sequence[str]) -> str:
    actionable = []
    for result in results:
        body = result.strip()
        if not body:
            continue
        # Keep the chunk header for traceability, but drop chunks that are only ok.
        without_header = re.sub(r"^# Chunk \d+/\d+\s*", "", body, flags=re.S).strip()
        if without_header.lower() == "ok":
            continue
        actionable.append(body)
    return "\n\n".join(actionable) if actionable else "ok"


def build_final_report(config: Dict[str, Any], args: argparse.Namespace, chunk_results: Sequence[str]) -> str:
    prompts = config["prompts"]
    normalized = normalize_chunk_results(chunk_results)
    if normalized == "ok":
        return "Summary\n-------\nNo actionable journal errors were found in the analyzed time range.\n\nPriority 1 - Fix soon\n---------------------\nNone.\n"
    template = str(prompts["final_user_template"])
    user_prompt = template.format(chunk_results=normalized)
    return call_ai(config, args, get_final_system_prompt(config, args), user_prompt).strip()


def save_outputs(save_dir: str, chunk_results: Sequence[str], final_report: Optional[str]) -> None:
    if not save_dir:
        return
    out_dir = Path(save_dir)
    out_dir.mkdir(parents=True, exist_ok=True)
    timestamp = _dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    if chunk_results:
        (out_dir / f"journal-ai-chunk-results-{timestamp}.txt").write_text(
            "\n\n".join(chunk_results) + "\n", encoding="ascii", errors="replace"
        )
    if final_report is not None:
        (out_dir / f"journal-ai-report-{timestamp}.txt").write_text(
            final_report + "\n", encoding="ascii", errors="replace"
        )


def resolve_mail_to(args: argparse.Namespace, config: Dict[str, Any]) -> Optional[str]:
    if args.mail is None:
        return None
    if args.mail == "__CONFIG_DEFAULT__":
        configured = str(config["mail"].get("default_to", "")).strip()
        if not configured:
            raise AnalyzerError("--mail was used without ADDRESS, but mail.default_to is empty in the config.")
        return configured
    return str(args.mail).strip()


def send_mail(config: Dict[str, Any], to_address: str, body: str) -> None:
    mail = config["mail"]
    message = EmailMessage()
    message["From"] = str(mail.get("from", "journal-ai-analyzer@localhost"))
    message["To"] = to_address
    message["Subject"] = str(mail.get("subject", "Linux journal AI report"))
    message.set_content(ascii_text(body))

    server = str(mail.get("smtp_server", "localhost"))
    port = int(mail.get("smtp_port", 25))
    username = str(mail.get("smtp_username", ""))
    password = str(mail.get("smtp_password", ""))
    use_tls = bool(mail.get("use_tls", False))
    use_starttls = bool(mail.get("use_starttls", False))

    if use_tls:
        smtp: smtplib.SMTP = smtplib.SMTP_SSL(server, port, timeout=30, context=ssl.create_default_context())
    else:
        smtp = smtplib.SMTP(server, port, timeout=30)
    try:
        if use_starttls:
            smtp.starttls(context=ssl.create_default_context())
        if username:
            smtp.login(username, password)
        smtp.send_message(message)
    finally:
        smtp.quit()


def warning_suppressed(config: Dict[str, Any], args: argparse.Namespace) -> bool:
    return bool(args.no_warn or config.get("safety", {}).get("no_warn", False) or args.mock_ai)


def confirm_before_api(config: Dict[str, Any], args: argparse.Namespace, line_count: int) -> None:
    if warning_suppressed(config, args):
        return
    api_url = normalize_api_url(args.api_url, args.api_path)
    message = f"""
WARNING: System journal data will be sent to and processed by the configured AI model.

API URL: {api_url}
Journal lines captured: {line_count}

This may create significant costs depending on the amount of data that has been captured.
The system journal may contain sensitive data such as hostnames, usernames, IP addresses,
service names, file paths, error details, and security-relevant events.

If you are in the European Union, make sure your usage is GDPR-compliant. Consider using
appropriate models and deployment options, for example a local model, if you have not done
so already.

To suppress this warning in future runs, use --no-warn or set safety.no_warn = true in the config.
""".strip()
    print(message, file=sys.stderr)
    if not sys.stdin.isatty():
        raise AnalyzerError("Refusing to continue without confirmation in a non-interactive session. Use --no-warn after reviewing the privacy and cost implications.")
    answer = input("Do you want to continue? Type 'yes' to continue: ").strip().lower()
    if answer != "yes":
        raise AnalyzerError("Aborted by user before sending journal data to the AI model.")


def print_section(title: str, content: str) -> None:
    line = "=" * len(title)
    print(f"\n{title}\n{line}\n{content.strip()}\n")


def handle_special_options(argv: Sequence[str]) -> Optional[int]:
    pre_parser = build_pre_parser()
    pre_args, _ = pre_parser.parse_known_args(argv)

    if pre_args.version:
        print(f"journal-ai-analyzer {__version__}")
        return 0

    if pre_args.print_config_path:
        print(default_config_path())
        return 0

    if pre_args.install_config:
        try:
            target = install_config(Path(pre_args.install_config).expanduser(), force=pre_args.force)
        except AnalyzerError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 2
        print(f"Installed config to: {target}")
        return 0

    # Backward-compatible convenience from v2.x: generate a default config instead
    # of copying the example file. Kept hidden because the project workflow uses
    # --install-config journal-ai-analyzer.conf.example.
    if pre_args.init_config:
        target = resolve_config_path(pre_args.config) if pre_args.config else default_config_path()
        try:
            write_default_config(target, overwrite=pre_args.force)
        except AnalyzerError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 2
        print(f"Wrote config file: {target}")
        return 0

    return None


def main(argv: Optional[Sequence[str]] = None) -> int:
    argv = argv if argv is not None else sys.argv[1:]

    special_result = handle_special_options(argv)
    if special_result is not None:
        return special_result

    # Help must work even before a config exists.
    if any(arg in {"-h", "--help"} for arg in argv):
        parser = build_parser(copy.deepcopy(DEFAULT_CONFIG))
        parser.parse_args(argv)
        return 0

    pre_parser = build_pre_parser()
    pre_args, _ = pre_parser.parse_known_args(argv)
    config_path = resolve_config_path(pre_args.config)

    if not config_path.exists():
        print(f"Error: {missing_config_message(config_path)}", file=sys.stderr)
        return 2

    try:
        config = load_config(config_path)
    except AnalyzerError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 2

    parser = build_parser(config)
    args = parser.parse_args(argv)

    # These are already handled above, but keep them here for clarity if main is
    # called programmatically with a pre-parsed config.
    if args.print_config_path:
        print(default_config_path())
        return 0
    if args.install_config:
        try:
            target = install_config(Path(args.install_config).expanduser(), force=args.force)
        except AnalyzerError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 2
        print(f"Installed config to: {target}")
        return 0
    if args.init_config:
        target = resolve_config_path(args.config) if args.config else default_config_path()
        try:
            write_default_config(target, overwrite=args.force)
        except AnalyzerError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 2
        print(f"Wrote config file: {target}")
        return 0

    if args.chunksize <= 0:
        print("Error: --chunksize must be greater than zero.", file=sys.stderr)
        return 2

    patterns = split_config_list(config["journal"].get("exclude_patterns", []))
    # Backward compatibility for old configs; not documented anymore.
    legacy_single_pattern = str(config["journal"].get("exclude_pattern", "") or "")
    if legacy_single_pattern:
        patterns.extend(split_config_list(legacy_single_pattern))
    temp_path: Optional[Path] = None
    try:
        if args.input_file:
            temp_path, line_count = collect_from_input_file(args.input_file, patterns)
            source_description = f"input file {args.input_file}"
        else:
            command = build_journal_command(args, config)
            source_description = " ".join(command)
            temp_path, line_count = collect_journal(command, patterns)

        print(f"Collected {line_count} filtered journal line(s) from: {source_description}", file=sys.stderr)

        if args.print_journal:
            print_section("Filtered journal lines", temp_path.read_text(encoding="utf-8", errors="replace"))

        if args.dry_run:
            print("Dry run complete. No API calls were made.", file=sys.stderr)
            return 0

        if line_count == 0:
            final_report = "Summary\n-------\nNo journal lines matched the selected time range and priority filter.\n"
            if args.mode in {"report", "all"}:
                print_section("Final report", final_report)
            mail_to = resolve_mail_to(args, config)
            if mail_to:
                send_mail(config, mail_to, final_report)
                print(f"Report sent to {mail_to}", file=sys.stderr)
            return 0

        confirm_before_api(config, args, line_count)

        chunk_results = analyze_chunks(config, args, temp_path, line_count)
        final_report: Optional[str] = None

        if args.mode in {"errors", "all"}:
            printable = "\n\n".join(chunk_results) if chunk_results else "ok"
            print_section("Chunk analysis results", printable)

        if args.mode in {"report", "all"} or args.mail is not None:
            final_report = build_final_report(config, args, chunk_results)
            if args.mode in {"report", "all"}:
                print_section("Final report", final_report)

        save_outputs(args.save_dir, chunk_results, final_report)

        mail_to = resolve_mail_to(args, config)
        if mail_to:
            mail_body = final_report if final_report is not None else "\n\n".join(chunk_results)
            send_mail(config, mail_to, mail_body)
            print(f"Report sent to {mail_to}", file=sys.stderr)
        return 0
    except KeyboardInterrupt:
        print("Interrupted.", file=sys.stderr)
        return 130
    except AnalyzerError as exc:
        print("", file=sys.stderr)
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    finally:
        if temp_path is not None:
            temp_path.unlink(missing_ok=True)


if __name__ == "__main__":
    raise SystemExit(main())

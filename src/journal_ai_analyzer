def write_default_config(path: Path, overwrite: bool = False) -> None:
    if path.exists() and not overwrite:
        raise AnalyzerError(f"Config file already exists: {path}. Use --force to overwrite.")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(render_default_config(), encoding="utf-8")
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass


def build_pre_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--config", help="Path to key=value configuration file (.conf); legacy JSON is also accepted.")
    parser.add_argument("--print-config-path", action="store_true", help="Print the default user config path and exit.")
    parser.add_argument("--install-config", metavar="EXAMPLE_CONFIG", help="Copy EXAMPLE_CONFIG to the default user config path and exit.")
    parser.add_argument("--force", action="store_true", help="Overwrite an existing config file when used with --install-config.")
    parser.add_argument("--version", action="store_true", help="Print version and exit.")
    # Compatibility with the earlier standalone script. Hidden from --help.
    parser.add_argument("--init-config", action="store_true", help=argparse.SUPPRESS)
    return parser


def build_parser(config: Dict[str, Any]) -> argparse.ArgumentParser:
    journal = config["journal"]
    defaults = config["defaults"]
    openai = config["openai"]

    parser = argparse.ArgumentParser(
        description="Analyze Linux journalctl output in chunks with an OpenAI-compatible API."
    )
    parser.add_argument("--config", help="Path to key=value configuration file (.conf); legacy JSON is also accepted.")
    parser.add_argument("--version", action="version", version=f"journal-ai-analyzer {__version__}")
    parser.add_argument("--print-config-path", action="store_true", help="Print the default user config path and exit.")
    parser.add_argument("--install-config", metavar="EXAMPLE_CONFIG", help="Copy EXAMPLE_CONFIG to the default user config path and exit.")
    parser.add_argument("--force", action="store_true", help="Overwrite an existing config file when used with --install-config.")
    parser.add_argument("--init-config", action="store_true", help=argparse.SUPPRESS)

    parser.add_argument(
        "--since",
        default=journal.get("since", "24 hours ago"),
        help="Start time passed directly to journalctl --since, e.g. '24 hours ago'.",
    )
    parser.add_argument(
        "--until",
        default=journal.get("until", ""),

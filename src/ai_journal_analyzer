def normalize_api_url(api_url: str, api_path: str) -> str:
    """Return the full API endpoint from a base URL and endpoint path.

    `api_url` is intentionally treated as a base URL for user clarity. For
    backward compatibility, a full legacy endpoint such as
    https://api.openai.com/v1/chat/completions is accepted unchanged when
    api_path is empty.
    """
    url = str(api_url or "").strip().rstrip("/")
    path = str(api_path or "").strip()
    if not url:
        raise AnalyzerError("openai.api_url / --api-url must not be empty.")
    # Backward compatibility for older configs where api_url contained the full endpoint.
    if re.search(r"/v\d+/(responses|chat/completions)$", url):
        return url
    if not path:
        return url
    if not path.startswith("/"):
        path = "/" + path
    return url + path




def endpoint_is_local(endpoint_url: str) -> bool:
    try:
        parsed = urllib.parse.urlparse(endpoint_url)
        host = (parsed.hostname or "").strip().lower()
        if host in {"localhost", "ip6-localhost"}:
            return True
        if not host:
            return False
        try:
            return ipaddress.ip_address(host).is_loopback
        except ValueError:
            return False
    except Exception:
        return False


def format_endpoint_status(endpoint_url: str) -> str:
    if endpoint_is_local(endpoint_url):
        return f"Endpoint appears to be local: {endpoint_url}"
    return f"Analyzing with endpoint: {endpoint_url}"

def getenv_or_config(config: Dict[str, Any], section: str, key: str, env_name: str = "") -> str:
    if env_name:
        env_value = os.environ.get(env_name, "")
        if env_value:
            return env_value
    value = config.get(section, {}).get(key, "")
    return str(value) if value is not None else ""


def ascii_text(text: str) -> str:
    return text.encode("ascii", "replace").decode("ascii")


def split_config_list(value: Any) -> List[str]:
    """Parse empty, comma-separated, repeated-key, or heredoc config values."""
    if value is None:
        return []
    if isinstance(value, list):
        items: List[str] = []
        for item in value:
            items.extend(split_config_list(item))
        return items
    text = str(value).strip()
    if not text:
        return []
    items = []
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        # Comma-separated values are intended for simple patterns/topics.
        # Regexes containing commas should be configured via heredoc, one per line.
        items.extend(part.strip() for part in line.split(",") if part.strip())
    return items


def build_journal_command(args: argparse.Namespace, config: Dict[str, Any]) -> List[str]:
    command = ["journalctl"]
    if args.boot:
        command.append("-b")

    configured_units = split_config_list(config.get("journal", {}).get("units", []))
    cli_units = split_config_list(args.units or [])
    units = cli_units or configured_units

    # journalctl matches for different fields are ANDed by default. Therefore,
    # selecting kernel messages and units at the same time needs explicit OR
    # disjunctions instead of simply combining -k and -u.
    if args.kernel and not units:
        command.append("-k")

    command.extend(["--since", args.since, "-p", args.loglevel, "--no-pager", "-o", "short-iso"])
    if args.until:
        command.extend(["--until", args.until])

    if args.kernel and units:
        command.append("_TRANSPORT=kernel")
        for unit in units:
            command.extend(["+", f"_SYSTEMD_UNIT={unit}"])
    elif units:
        for unit in units:
            command.extend(["-u", unit])

    return command


def should_exclude(line: str, keyword_patterns: Sequence[str], regex_patterns: Sequence[str]) -> bool:
    lowered = line.lower()
    for keyword in keyword_patterns:
        keyword = str(keyword).strip()
        if keyword and keyword.lower() in lowered:
            return True
    for pattern in regex_patterns:
        pattern = str(pattern).strip()
        if not pattern:
            continue
        try:
            if re.search(pattern, line):
                return True
        except re.error as exc:
            raise AnalyzerError(f"Invalid regex in journal.exclude_regex_patterns: {pattern!r}: {exc}") from exc
    return False


def write_filtered_lines_to_temp(
    line_iter: Iterable[str],
    keyword_patterns: Sequence[str],
    regex_patterns: Sequence[str],
    tail_lines: int = 0,
) -> Tuple[Path, int]:
    """Write filtered lines from any text iterator to a temp file.

    When tail_lines > 0, only the last N filtered lines are kept. This is
    intentionally implemented after filtering so --tail-lines describes the
    analyzed input size.
    """
    if tail_lines < 0:
        raise AnalyzerError("--tail-lines must be greater than or equal to zero.")
    temp = tempfile.NamedTemporaryFile("w", encoding="utf-8", delete=False, prefix="ai-journal-", suffix=".log")
    temp_path = Path(temp.name)
    count = 0
    try:
        with temp:
            if tail_lines > 0:
                kept = deque(maxlen=tail_lines)
                for raw_line in line_iter:
                    if should_exclude(raw_line, keyword_patterns, regex_patterns):
                        continue
                    kept.append(raw_line)
                for raw_line in kept:
                    temp.write(raw_line if raw_line.endswith("\n") else raw_line + "\n")
                count = len(kept)
            else:
                for raw_line in line_iter:
                    if should_exclude(raw_line, keyword_patterns, regex_patterns):
                        continue
                    temp.write(raw_line if raw_line.endswith("\n") else raw_line + "\n")
                    count += 1
    except Exception:
        try:
            temp_path.unlink(missing_ok=True)
        finally:
            raise
    return temp_path, count


def iter_input_files(paths: Sequence[str]) -> Iterator[str]:
    for input_file in paths:
        try:
            with open(input_file, "r", encoding="utf-8", errors="replace") as src:
                for raw_line in src:
                    yield raw_line
        except PermissionError as exc:
            raise AnalyzerError(
                f"Permission denied while reading input file: {input_file}. Run with suitable permissions or choose another file."
            ) from exc
        except FileNotFoundError as exc:
            raise AnalyzerError(f"Input file not found: {input_file}") from exc


def collect_from_input_files(
    input_files: Sequence[str],
    keyword_patterns: Sequence[str],
    regex_patterns: Sequence[str],
    tail_lines: int = 0,
) -> Tuple[Path, int]:
    return write_filtered_lines_to_temp(iter_input_files(input_files), keyword_patterns, regex_patterns, tail_lines)


def collect_from_stdin(
    keyword_patterns: Sequence[str],
    regex_patterns: Sequence[str],
    tail_lines: int = 0,
) -> Tuple[Path, int]:
    return write_filtered_lines_to_temp(sys.stdin, keyword_patterns, regex_patterns, tail_lines)


# Backward compatibility for older test invocations.
def collect_from_input_file(input_file: str, keyword_patterns: Sequence[str], regex_patterns: Sequence[str]) -> Tuple[Path, int]:
    return collect_from_input_files([input_file], keyword_patterns, regex_patterns, 0)


def collect_journal(command: Sequence[str], keyword_patterns: Sequence[str], regex_patterns: Sequence[str]) -> Tuple[Path, int]:
    temp = tempfile.NamedTemporaryFile("w", encoding="utf-8", delete=False, prefix="ai-journal-", suffix=".log")
    temp_path = Path(temp.name)
    count = 0
    try:
        process = subprocess.Popen(
            list(command),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            encoding="utf-8",
            errors="replace",
        )
        assert process.stdout is not None
        with temp:
            for line in process.stdout:
                if should_exclude(line, keyword_patterns, regex_patterns):
                    continue
                temp.write(line)
                count += 1
        stderr = process.stderr.read() if process.stderr else ""
        return_code = process.wait()
    except FileNotFoundError as exc:
        temp_path.unlink(missing_ok=True)
        raise AnalyzerError("journalctl was not found. This script must run on a systemd-based Linux host.") from exc
    except Exception:
        temp_path.unlink(missing_ok=True)
        raise

    if return_code != 0:
        temp_path.unlink(missing_ok=True)
        raise AnalyzerError(f"journalctl failed with exit code {return_code}: {stderr.strip()}")
    return temp_path, count


def iter_chunks(path: Path, chunk_size: int) -> Iterator[List[str]]:
    if chunk_size <= 0:
        raise AnalyzerError("--chunksize must be greater than zero.")
    with path.open("r", encoding="utf-8", errors="replace") as handle:
        chunk: List[str] = []
        for line in handle:
            chunk.append(line.rstrip("\n"))
            if len(chunk) >= chunk_size:
                yield chunk
                chunk = []
        if chunk:
            yield chunk


def print_journal_file(path: Path) -> None:
    with path.open("r", encoding="utf-8", errors="replace") as handle:
        for line in handle:
            print(line, end="")


def progress_bar(current: int, total: int, width: int = 36) -> str:
    if total <= 0:
        return "[" + "." * width + "] 0%"
    ratio = min(max(current / total, 0.0), 1.0)
    filled = int(round(width * ratio))
    return f"[{'#' * filled}{'.' * (width - filled)}] {ratio * 100:5.1f}% ({current}/{total})"


def write_progress(current: int, total: int, enabled: bool) -> None:
    if not enabled:
        return
    sys.stderr.write("\r" + progress_bar(current, total))
    sys.stderr.flush()
    if current >= total:
        sys.stderr.write("\n")
        sys.stderr.flush()


def build_chat_payload(config: Dict[str, Any], model: str, system_prompt: str, user_prompt: str) -> Dict[str, Any]:
    openai_cfg = config["openai"]
    payload: Dict[str, Any] = {
        "model": model,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt},
        ],
    }
    if openai_cfg.get("temperature") is not None:
        payload["temperature"] = openai_cfg.get("temperature")
    max_output_tokens = openai_cfg.get("max_output_tokens")
    if max_output_tokens is not None:
        payload[str(openai_cfg.get("max_tokens_field", "max_tokens"))] = int(max_output_tokens)
    return payload


def build_responses_payload(config: Dict[str, Any], model: str, system_prompt: str, user_prompt: str) -> Dict[str, Any]:
    openai_cfg = config["openai"]
    payload: Dict[str, Any] = {
        "model": model,
        "instructions": system_prompt,
        "input": user_prompt,
    }
    if openai_cfg.get("temperature") is not None:
        payload["temperature"] = openai_cfg.get("temperature")
    max_output_tokens = openai_cfg.get("max_output_tokens")
    if max_output_tokens is not None:
        payload["max_output_tokens"] = int(max_output_tokens)
    return payload


def extract_response_text(data: Dict[str, Any], api_style: str) -> str:
    if api_style == "responses":
        if isinstance(data.get("output_text"), str):
            return data["output_text"]
        parts: List[str] = []
        for item in data.get("output", []) or []:
            for content in item.get("content", []) or []:
                if isinstance(content.get("text"), str):
                    parts.append(content["text"])
                elif isinstance(content.get("text"), dict) and isinstance(content["text"].get("value"), str):
                    parts.append(content["text"]["value"])
        if parts:
            return "\n".join(parts)
    choices = data.get("choices", [])
    if choices:
        first = choices[0]
        message = first.get("message", {})
        content = message.get("content")
        if isinstance(content, str):
            return content
        if isinstance(content, list):
            parts = []
            for item in content:
                if isinstance(item, dict):
                    if isinstance(item.get("text"), str):
                        parts.append(item["text"])
                    elif isinstance(item.get("content"), str):
                        parts.append(item["content"])
            if parts:
                return "\n".join(parts)
        if isinstance(first.get("text"), str):
            return first["text"]
    raise AnalyzerError("Could not extract text from API response.")


def call_ai(config: Dict[str, Any], args: argparse.Namespace, system_prompt: str, user_prompt: str) -> str:
    if args.mock_ai:
        return mock_ai_response(system_prompt, user_prompt)

    api_style = args.api_style
    api_url = normalize_api_url(args.api_url, args.api_path)
    api_key = os.environ.get("OPENAI_API_KEY") or str(config["openai"].get("api_key", ""))
    headers = {"Content-Type": "application/json"}
    if api_key and api_key.strip() and api_key.strip() not in {"YOUR_KEY", "YOUR_OPENAI_API_KEY"}:
        headers["Authorization"] = f"Bearer {api_key.strip()}"
    headers.update({str(k): str(v) for k, v in (config["openai"].get("extra_headers") or {}).items()})

    if api_style == "responses":
        payload = build_responses_payload(config, args.model, system_prompt, user_prompt)
    else:
        payload = build_chat_payload(config, args.model, system_prompt, user_prompt)

    body = json.dumps(payload).encode("utf-8")
    timeout = int(config["openai"].get("timeout_seconds", 120))
    max_retries = max(0, int(config["openai"].get("max_retries", 1)))
    total_attempts = 1 + max_retries
    backoff = float(config["openai"].get("retry_backoff_seconds", 2))

    last_error: Optional[Exception] = None
    for attempt in range(1, total_attempts + 1):
        request = urllib.request.Request(api_url, data=body, headers=headers, method="POST")
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                response_body = response.read().decode("utf-8", errors="replace")
            data = json.loads(response_body)
            text = ascii_text(extract_response_text(data, api_style))
            if not text.strip():
                raise EmptyAIResponseError("API returned an empty response text.")
            return text
        except urllib.error.HTTPError as exc:
            error_body = exc.read().decode("utf-8", errors="replace")
            last_error = AnalyzerError(f"API HTTP {exc.code}: {error_body[:2000]}")
            if exc.code not in {408, 409, 425, 429, 500, 502, 503, 504}:
                break
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, AnalyzerError) as exc:
            last_error = exc
        if attempt < total_attempts:
            time.sleep(backoff * attempt)
    if isinstance(last_error, EmptyAIResponseError):
        raise AnalyzerError(
            "The AI model returned no usable text after "
            f"{total_attempts} API attempt(s).\n\n"
            "This often means the model/context window failed or the proxy returned no content.\n"
            "Try these steps:\n"
            f"  1. Reduce journal.chunksize. Current value: {args.chunksize} lines.\n"
            "  2. Increase openai.max_output_tokens if the model is likely truncating the answer. "
            f"Current value: {config['openai'].get('max_output_tokens', '')}.\n"
            "  3. If you use Ollama or LiteLLM, check the model context size and proxy logs.\n"
            "  4. Try a smaller time range with --since.\n\n"
            "The current chunk was not analyzed. Aborting to avoid an incomplete report."
        )
    raise AnalyzerError(f"API request failed after {total_attempts} attempt(s): {last_error}")


def mock_ai_response(system_prompt: str, user_prompt: str) -> str:
    # This is intentionally simple and is only for local smoke tests.
    timestamp_mode = "Timestamp mode is enabled" in system_prompt
    if "chunk analyses" in user_prompt.lower() or "prioritized" in user_prompt.lower():
        findings = [line for line in user_prompt.splitlines() if line.startswith("* Error:")]
        timestamp_lines = [line for line in user_prompt.splitlines() if line.startswith("* Examples:")]
        if not findings:
            return "Summary\n-------\nNo actionable errors found.\n\nPriority 1 - Fix soon\n---------------------\nNone."
        timestamp_note = ""
        if timestamp_mode and timestamp_lines:
            timestamp_note = "\n" + "\n".join(line.lstrip("* ") for line in timestamp_lines[-3:])
        return (
            "Summary\n-------\nActionable journal events were found.\n\n"
            "Priority 1 - Fix soon\n---------------------\n"
            "Review the listed failed services or errors and inspect them with systemctl status and journalctl.\n"
            "Search: journalctl --since \"24 hours ago\" -p warning..alert --no-pager -o short-iso | grep -E \"failed|error\""
            f"{timestamp_note}\n"
        )
    errors = []
    for line in user_prompt.splitlines():
        if re.search(r"\b(error|failed|failure|critical|alert|denied|unauthorized|segfault|panic)\b", line, re.I):
            errors.append(line)
    if not errors:
        return "ok"
    deduped = list(dict.fromkeys(errors))[:20]
    rendered = []
    for line in deduped:
        ts_line = ""
        if timestamp_mode:
            timestamp = line.split(maxsplit=1)[0] if line else "unknown"
            ts_line = f"\n* Examples: {timestamp} (first seen, last seen)"
        rendered.append(f"* Error: {line}{ts_line}\n* Search: journalctl --since \"24 hours ago\" -p warning..alert --no-pager -o short-iso | grep -E \"error|failed\"\n* Explanation: Mock analysis: this line looks actionable and should be checked.")
    return "\n\n".join(rendered)



def timestamps_enabled(config: Dict[str, Any], args: argparse.Namespace) -> bool:
    if args.include_timestamps is not None:
        return bool(args.include_timestamps)
    return bool(config.get("timestamps", {}).get("enabled", False))


def build_timestamp_chunk_suffix(config: Dict[str, Any], args: argparse.Namespace) -> str:
    if not timestamps_enabled(config, args):
        return ""
    samples = max(1, int(args.timestamp_samples))
    return f"""

Timestamp mode is enabled.
For every actionable error, include one compact Examples line directly after the Error line.
Use only timestamps that appear at the beginning of matching journal lines. Sort timestamps chronologically.

The per-error timestamp format must be exactly:
* Examples: <oldest matching timestamp> (first seen), <up to {samples} representative timestamps>, <newest matching timestamp> (last seen)

If a finding appears only once, use:
* Examples: <timestamp> (first seen, last seen)

Do not use separate First seen or Last seen lines. Keep output ASCII only.
"""


def build_timestamp_final_suffix(config: Dict[str, Any], args: argparse.Namespace) -> str:
    if not timestamps_enabled(config, args):
        return ""
    samples = max(1, int(args.timestamp_samples))
    return f"""

Timestamp mode is enabled.
The chunk analyses may contain '* Examples:' lines in this compact format:
Examples: <timestamp 1> (first seen), <timestamp 2>, ... <timestamp N> (last seen)
Preserve this compact Examples format in the final report for each report item whenever available.
Do not output separate First seen or Last seen lines.
Do not invent timestamps that are not present in the chunk analyses.
"""



def build_search_command_suffix(config: Dict[str, Any], args: argparse.Namespace, *, final_report: bool = False) -> str:
    base_command = str(getattr(args, "_journal_search_base", "") or "journalctl --since ... -p ... --no-pager -o short-iso").strip()
    if final_report:
        return f"""

Search command mode is enabled.
The chunk analyses may contain '* Search:' lines. Preserve or improve one Search line for every final report item whenever possible.
Search lines must be based on the original journal query and use grep -E with a compact, shell-safe regular expression:
Search: {base_command} | grep -E '<regex matching the relevant messages>'
Keep regexes practical and specific enough for an admin to find the messages again.
"""
    return f"""

Search command mode is enabled.
For every actionable error, include a Search line after the Examples line and before the Explanation line.
Use the original journal query plus grep -E with a compact, shell-safe regular expression that finds matching messages again.
Use this format exactly:
* Search: {base_command} | grep -E '<regex matching the relevant messages>'
Keep regexes practical and specific. Prefer stable words from the message such as service names, unit names, error codes, resource names, or protocol names.
"""

def build_scope_suffix(config: Dict[str, Any], args: argparse.Namespace, *, final_report: bool = False) -> str:
    parts: List[str] = []
    focus_on = str(getattr(args, "focus_on", "") or config.get("journal", {}).get("focus_on", "") or "").strip()
    if focus_on:
        if final_report:
            parts.append(
                "The user focus is: "
                + focus_on
                + ". Include only findings that clearly match this focus. "
                "Do not include non-focus findings, even if they are otherwise important. "
                "If no focus-matching incident is found, state that no matching issue was found in the analyzed journal lines."
            )
        else:
            parts.append(
                "Focus only on findings related to: "
                + focus_on
                + ". Do not include unrelated findings. "
                "Return ok if the chunk contains no actionable findings matching this focus."
            )

    gently_ignore_topics = split_config_list(
        getattr(args, "gently_ignore", "") or config.get("journal", {}).get("gently_ignore", "") or config.get("journal", {}).get("exclude_ai_patterns", "")
    )
    if gently_ignore_topics:
        rendered = "\n".join(f"- {topic}" for topic in gently_ignore_topics)
        parts.append(
            "Gently ignore findings that only match these user-defined topics unless they indicate a severe security, "
            "data-loss, hardware, or service-availability risk. Apply this guidance both to prioritization and wording:\n"
            + rendered
        )
    if not parts:
        return ""
    heading = "User-defined report scope" if final_report else "User-defined analysis scope"
    return "\n\n" + heading + ":\n" + "\n\n".join(parts) + "\n"


def get_chunk_system_prompt(config: Dict[str, Any], args: argparse.Namespace) -> str:
    return (
        str(config["prompts"]["chunk_system"])
        + build_scope_suffix(config, args, final_report=False)
        + build_timestamp_chunk_suffix(config, args)
        + build_search_command_suffix(config, args, final_report=False)
    )


def get_final_system_prompt(config: Dict[str, Any], args: argparse.Namespace) -> str:
    return (
        str(config["prompts"]["final_system"])
        + build_scope_suffix(config, args, final_report=True)
        + build_timestamp_final_suffix(config, args)
        + build_search_command_suffix(config, args, final_report=True)
    )


def response_is_ok(text: str) -> bool:
    normalized = re.sub(r"[\s.!,;:]+", "", text.strip().lower())
    return normalized in {"ok", "okay"}



def analyze_chunks(config: Dict[str, Any], args: argparse.Namespace, journal_path: Path, line_count: int) -> List[str]:
    chunk_size = int(args.chunksize)
    total_chunks = max(1, math.ceil(line_count / chunk_size)) if line_count else 0
    results: List[str] = []
    prompts = config["prompts"]
    progress_enabled = bool(config["defaults"].get("progress", True)) and not args.no_progress
    if total_chunks > 0:
        print(f"\n* Creating error summaries for chunks (chunksize = {chunk_size} lines)", file=sys.stderr)
        write_progress(0, total_chunks, progress_enabled)

    chunk_system_prompt = get_chunk_system_prompt(config, args)
    for idx, chunk in enumerate(iter_chunks(journal_path, chunk_size), start=1):
        chunk_text = "\n".join(chunk)
        user_prompt = f"{prompts.get('chunk_user_prefix', '')}{chunk_text}"
        result = call_ai(config, args, chunk_system_prompt, user_prompt).strip()
        if not result:
            raise AnalyzerError(f"AI returned an empty result for chunk {idx}/{total_chunks}; aborting to avoid an incomplete report.")
        if args.debug_ai:
            state = "ok" if response_is_ok(result) else "finding"
            print(f"Debug: chunk {idx}/{total_chunks}: final AI result state = {state}", file=sys.stderr)
        if result:
            results.append(f"# Chunk {idx}/{total_chunks}\n{result}")
        write_progress(idx, total_chunks, progress_enabled)
    return results


def normalize_chunk_results(results: Sequence[str]) -> str:
    actionable = []
    for result in results:
        body = result.strip()
        if not body:
            continue
        # Keep the chunk header for traceability, but drop chunks that are only ok.
        without_header = re.sub(r"^# Chunk \d+/\d+\s*", "", body, flags=re.S).strip()
        if without_header.lower() == "ok":
            continue
        actionable.append(body)
    return "\n\n".join(actionable) if actionable else "ok"


def build_final_report(config: Dict[str, Any], args: argparse.Namespace, chunk_results: Sequence[str]) -> str:
    prompts = config["prompts"]
    normalized = normalize_chunk_results(chunk_results)
    if normalized == "ok":
        return "Summary\n-------\nNo actionable journal errors were found in the analyzed time range.\n\nPriority 1 - Fix soon\n---------------------\nNone.\n"
    template = str(prompts["final_user_template"])
    user_prompt = template.format(chunk_results=normalized)
    return call_ai(config, args, get_final_system_prompt(config, args), user_prompt).strip()


def save_outputs(save_dir: str, chunk_results: Sequence[str], final_report: Optional[str]) -> None:
    if not save_dir:
        return
    out_dir = Path(save_dir)
    out_dir.mkdir(parents=True, exist_ok=True)
    timestamp = _dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    if chunk_results:
        (out_dir / f"ai-journal-chunk-results-{timestamp}.txt").write_text(
            "\n\n".join(chunk_results) + "\n", encoding="ascii", errors="replace"
        )
    if final_report is not None:
        (out_dir / f"ai-journal-report-{timestamp}.txt").write_text(
            final_report + "\n", encoding="ascii", errors="replace"
        )


def resolve_mail_to(args: argparse.Namespace, config: Dict[str, Any]) -> Optional[str]:
    if args.mail is None:
        return None
    if args.mail == "__CONFIG_DEFAULT__":
        configured = str(config["mail"].get("default_to", "")).strip()
        if not configured:
            raise AnalyzerError("--mail was used without ADDRESS, but mail.default_to is empty in the config.")
        return configured
    return str(args.mail).strip()


def send_mail(config: Dict[str, Any], to_address: str, body: str) -> None:
    mail = config["mail"]
    message = EmailMessage()
    message["From"] = str(mail.get("from", "ai-journal-analyzer@localhost"))
    message["To"] = to_address
    message["Subject"] = str(mail.get("subject", "Linux journal AI report"))
    message.set_content(ascii_text(body))

    server = str(mail.get("smtp_server", "localhost"))
    port = int(mail.get("smtp_port", 25))
    username = str(mail.get("smtp_username", ""))
    password = str(mail.get("smtp_password", ""))
    use_tls = bool(mail.get("use_tls", False))
    use_starttls = bool(mail.get("use_starttls", False))

    if use_tls:
        smtp: smtplib.SMTP = smtplib.SMTP_SSL(server, port, timeout=30, context=ssl.create_default_context())
    else:
        smtp = smtplib.SMTP(server, port, timeout=30)
    try:
        if use_starttls:
            smtp.starttls(context=ssl.create_default_context())
        if username:
            smtp.login(username, password)
        smtp.send_message(message)
    finally:
        smtp.quit()


def warning_suppressed(config: Dict[str, Any], args: argparse.Namespace) -> bool:
    return bool(args.no_warn or config.get("safety", {}).get("no_warn", False) or args.mock_ai)



def warn_limited_journal_access(args: argparse.Namespace) -> None:
    if os.name != "posix" or os.geteuid() == 0:
        return
    print(
        "\nWARNING: ai-journal-analyzer is not running as root. Journal access may be limited.\n"
        "For full system journal access, run the tool with sudo, for example: sudo ai-journal-analyzer ...",
        file=sys.stderr,
    )

def confirm_before_api(config: Dict[str, Any], args: argparse.Namespace, line_count: int) -> None:
    if warning_suppressed(config, args):
        return
    api_url = normalize_api_url(args.api_url, args.api_path)
    endpoint_line = format_endpoint_status(api_url) if endpoint_is_local(api_url) else f"Endpoint: {api_url}"
    message = f"""
WARNING: {line_count} journal lines will be sent to the configured AI endpoint.

{endpoint_line}
Logs may contain hostnames, usernames, IP addresses, paths, service names and security-relevant events.
Costs may apply depending on your model/provider.

Use --print-journal to inspect the filtered input first.
Use --no-warn or set safety.no_warn = true to suppress this warning.
""".strip()
    print("\n" + message, file=sys.stderr)
    if not sys.stdin.isatty():
        raise AnalyzerError("Refusing to continue without confirmation in a non-interactive session. Use --no-warn after reviewing the filtered journal input and endpoint.")
    answer = input("Continue? Type 'yes': ").strip().lower()
    if answer != "yes":
        raise AnalyzerError("Aborted by user before sending journal data to the configured AI endpoint.")

def print_section(title: str, content: str) -> None:
    line = "=" * len(title)
    print(f"\n{title}\n{line}\n{content.strip()}\n")


def resolve_plain_log_inputs(config: Dict[str, Any], args: argparse.Namespace) -> List[str]:
    """Return configured/CLI plain log input files.

    CLI --file wins over config input.files. The legacy hidden --input-file is
    treated as an additional --file for compatibility with older tests.
    """
    input_cfg = config.get("input", {})
    configured_files = split_config_list(input_cfg.get("files", []))
    cli_files = split_config_list(args.input_files or [])
    legacy_file = str(getattr(args, "input_file", "") or "").strip()
    if legacy_file:
        cli_files.append(legacy_file)
    return cli_files or configured_files


def describe_file_source(input_files: Sequence[str], tail_lines: int) -> str:
    base = "input file " + ", ".join(shlex.quote(str(p)) for p in input_files)
    if len(input_files) > 1:
        base = "input files " + ", ".join(shlex.quote(str(p)) for p in input_files)
    if tail_lines > 0:
        base += f" (last {tail_lines} filtered line(s))"
    return base


def build_file_search_base(input_files: Sequence[str], tail_lines: int) -> str:
    cat_cmd = "cat " + " ".join(shlex.quote(str(p)) for p in input_files)
    if tail_lines > 0:
        return f"{cat_cmd} | tail -n {tail_lines}"
    return cat_cmd


def build_stdin_search_base(tail_lines: int) -> str:
    if tail_lines > 0:
        return f"cat <same-input-file-or-pipe> | tail -n {tail_lines}"
    return "cat <same-input-file-or-pipe>"


def handle_special_options(argv: Sequence[str]) -> Optional[int]:
    pre_parser = build_pre_parser()
    pre_args, _ = pre_parser.parse_known_args(argv)

    if pre_args.version:
        print(f"ai-journal-analyzer {__version__}")
        return 0

    if pre_args.print_config_path:
        print(default_config_path())
        return 0

    # Hidden compatibility helper for older standalone workflows. It writes the default config
    # to the resolved path, but intentionally does not overwrite existing files.
    if pre_args.init_config:
        target = resolve_config_path(pre_args.config) if pre_args.config else default_config_path()
        try:
            write_default_config(target, overwrite=False)
        except AnalyzerError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 2
        print(f"Wrote config file: {target}")
        return 0

    return None


def main(argv: Optional[Sequence[str]] = None) -> int:
    argv = argv if argv is not None else sys.argv[1:]

    special_result = handle_special_options(argv)
    if special_result is not None:
        return special_result

    # Help must work even before a config exists.
    if any(arg in {"-h", "--help"} for arg in argv):
        parser = build_parser(copy.deepcopy(DEFAULT_CONFIG))
        parser.parse_args(argv)
        return 0

    pre_parser = build_pre_parser()
    pre_args, _ = pre_parser.parse_known_args(argv)
    config_path = resolve_config_path(pre_args.config)

    if not config_path.exists():
        print(f"Error: {missing_config_message(config_path)}", file=sys.stderr)
        return 2

    try:
        config = load_config(config_path)
    except AnalyzerError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 2

    parser = build_parser(config)
    args = parser.parse_args(argv)

    # These are already handled above, but keep them here for clarity if main is
    # called programmatically with a pre-parsed config.
    if args.print_config_path:
        print(default_config_path())
        return 0
    if args.init_config:
        target = resolve_config_path(args.config) if args.config else default_config_path()
        try:
            write_default_config(target, overwrite=False)
        except AnalyzerError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 2
        print(f"Wrote config file: {target}")
        return 0

    if args.chunksize <= 0:
        print("Error: --chunksize must be greater than zero.", file=sys.stderr)
        return 2

    keyword_patterns = split_config_list(config["journal"].get("exclude_patterns", []))
    if args.exclude_patterns:
        keyword_patterns.extend(split_config_list(args.exclude_patterns))
    regex_patterns = split_config_list(config["journal"].get("exclude_regex_patterns", []))
    if args.exclude_regex_patterns:
        regex_patterns.extend(split_config_list(args.exclude_regex_patterns))
    # Backward compatibility for old configs; treat the old singular name as a simple keyword now.
    legacy_single_pattern = str(config["journal"].get("exclude_pattern", "") or "")
    if legacy_single_pattern:
        keyword_patterns.extend(split_config_list(legacy_single_pattern))

    temp_path: Optional[Path] = None
    try:
        input_files = resolve_plain_log_inputs(config, args)
        if args.input_stdin and input_files:
            raise AnalyzerError("Use either --stdin or --file, not both.")

        if args.input_stdin:
            temp_path, line_count = collect_from_stdin(keyword_patterns, regex_patterns, args.tail_lines)
            source_description = "standard input"
            if args.tail_lines > 0:
                source_description += f" (last {args.tail_lines} filtered line(s))"
            args._journal_search_base = build_stdin_search_base(args.tail_lines)
            collected_label = "log line(s)"
        elif input_files:
            temp_path, line_count = collect_from_input_files(input_files, keyword_patterns, regex_patterns, args.tail_lines)
            source_description = describe_file_source(input_files, args.tail_lines)
            args._journal_search_base = build_file_search_base(input_files, args.tail_lines)
            collected_label = "log line(s)"
        else:
            command = build_journal_command(args, config)
            source_description = " ".join(command)
            args._journal_search_base = shlex.join(command)
            temp_path, line_count = collect_journal(command, keyword_patterns, regex_patterns)
            collected_label = "journal line(s)"
            warn_limited_journal_access(args)

        print(f"\nCollected {line_count} filtered {collected_label} from: {source_description}", file=sys.stderr)

        if args.max_lines > 0 and line_count > args.max_lines:
            raise AnalyzerError(
                f"Filtered journal input contains {line_count} lines, which exceeds the safety limit of {args.max_lines} lines.\n"
                "Reduce the time range or filters, or increase the limit with --max-lines NUMBER "
                "or journal.max_lines = NUMBER in the config."
            )

        if args.print_journal:
            print_section("Filtered input lines", temp_path.read_text(encoding="utf-8", errors="replace"))

        if args.dry_run:
            print("Dry run complete. No API calls were made.", file=sys.stderr)
            return 0

        if line_count == 0:
            final_report = "Summary\n-------\nNo input lines matched the selected filters.\n"
            if args.mode in {"report", "all"}:
                print_section("Final report", final_report)
            mail_to = resolve_mail_to(args, config)
            if mail_to:
                send_mail(config, mail_to, final_report)
                print(f"Report sent to {mail_to}", file=sys.stderr)
            return 0

        confirm_before_api(config, args, line_count)
        print("\n" + format_endpoint_status(normalize_api_url(args.api_url, args.api_path)), file=sys.stderr)

        chunk_results = analyze_chunks(config, args, temp_path, line_count)
        final_report: Optional[str] = None

        if args.mode in {"errors", "all"} or args.debug_ai:
            printable = "\n\n".join(chunk_results) if chunk_results else "ok"
            print_section("Chunk analysis results", printable)

        if args.mode in {"report", "all"} or args.mail is not None:
            print("\n* Creating final report\n", file=sys.stderr)
            final_report = build_final_report(config, args, chunk_results)
            if args.mode in {"report", "all"}:
                print_section("Final report", final_report)

        save_outputs(args.save_dir, chunk_results, final_report)

        mail_to = resolve_mail_to(args, config)
        if mail_to:
            mail_body = final_report if final_report is not None else "\n\n".join(chunk_results)
            send_mail(config, mail_to, mail_body)
            print(f"Report sent to {mail_to}", file=sys.stderr)
        return 0
    except KeyboardInterrupt:
        print("Interrupted.", file=sys.stderr)
        return 130
    except AnalyzerError as exc:
        print("", file=sys.stderr)
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    finally:
        if temp_path is not None:
            temp_path.unlink(missing_ok=True)


if __name__ == "__main__":
    raise SystemExit(main())

# journal_ai_analyzer.conf
# Format: key = value
# Comments: Lines starting with # are ignored. Inline comments are allowed after whitespace.
# Strings: Quotes are optional unless the value is empty or starts/ends with whitespace.
# Prompts: Multi-line values use: key <<EOF ... EOF

# Function: API key for OpenAI or an OpenAI-compatible server.
# Syntax: string. Empty means: read OPENAI_API_KEY from the environment if set.
openai.api_key = ""

# Function: API base URL only, without /v1/... endpoint path.
# Syntax: URL, for example https://api.openai.com, http://127.0.0.1:4000, or http://127.0.0.1:11434
openai.api_url = https://api.openai.com

# Function: API endpoint path appended to openai.api_url.
# Syntax: /v1/chat/completions recommended. /v1/responses is available for advanced use.
openai.api_path = /v1/chat/completions

# Function: Request payload style.
# Syntax: chat_completions recommended. responses is available for advanced use.
openai.api_style = chat_completions

# Function: Model name passed to the API.
# Syntax: OpenAI model name or local/proxy alias, for example gpt-5-mini, gemma3:27b, local.
openai.model = gpt-5-mini

# Function: Sampling temperature. Lower values usually improve deterministic formatting.
# Syntax: decimal number, for example 0, 0.1, 0.2.
openai.temperature = 0.1

# Function: Maximum output tokens for each AI response.
# Syntax: integer token limit, for example 1024, 2048, 4096.
openai.max_output_tokens = 2048

# Function: HTTP timeout for one API attempt.
# Syntax: integer seconds.
openai.timeout_seconds = 120

# Function: Number of API attempts before failing the run.
# Syntax: integer, for example 1, 2, 3.
openai.max_retries = 3

# Function: Base delay between retries. Attempt number is multiplied by this value.
# Syntax: seconds as integer or decimal, for example 2 or 5.0.
openai.retry_backoff_seconds = 2

# Function: Name of the max-token field for chat_completions payloads.
# Syntax: max_tokens for most OpenAI-compatible APIs; max_completion_tokens for selected newer APIs.
openai.max_tokens_field = max_tokens

# Function: Extra HTTP headers sent to the API.
# Syntax: JSON object, for example {"X-Header":"value"}. Use {} for none.
openai.extra_headers = {}

# Function: Start time passed directly to journalctl --since.
# Syntax: journalctl time expression, for example "24 hours ago", "2026-06-08 10:00:00", yesterday.
journal.since = 24 hours ago

# Function: Optional end time passed directly to journalctl --until.
# Syntax: empty for now, or a journalctl time expression.
journal.until = ""

# Function: Priority range passed to journalctl -p.
# Syntax: systemd priority or range, for example warning..alert, err..alert, info..alert.
journal.loglevel = warning..alert

# Function: Number of journal lines per AI request.
# Syntax: integer line count. 500 is recommended; best for 64k context-size with thinking model.
# Tips: 200 safer for small/local models; 500 recommended; 800 for larger context; 1000+ can fail despite nominal 64k.
journal.chunksize = 500

# Function: journalctl output format.
# Syntax: journalctl -o format, for example short-iso, short-iso-precise, json.
journal.output_format = short-iso

# Function: Run journalctl via sudo when the script is not already root.
# Syntax: true or false.
journal.use_sudo = false

# Function: Optional plain-text substring to exclude from journal lines before AI analysis.
# Syntax: empty string or exact substring. This is not a regex.
journal.exclude_pattern = ""

# Function: System prompt for per-chunk analysis.
# Syntax: multi-line text. The model should return exactly ok or Error/Timestamps/Explanation blocks.
prompts.chunk_system <<EOF
You are a senior Linux/SRE log analyst.
Analyze systemd journal entries and identify only actionable problems.

Return exactly "ok" if there are no events that require near-term action.
Otherwise quote only journal entries that need to be fixed soon, including:
- configuration errors
- failed services
- service errors
- security incidents
- storage, hardware, network, or kernel events that require action

Deduplicate repeated events and prefer the most representative journal line.
Ignore harmless noise, expected transient warnings, and any already-filtered patterns.
Use ASCII only.
Use exactly this format:

* Error: <journal entry>
* Timestamps: <timestamp 1>, <timestamp 2>, <timestamp 3>[; and more]
* Explanation: <explain the error, likely impact, and what to check next>

* Error: <journal entry>
* Timestamps: <timestamp 1>, <timestamp 2>, <timestamp 3>[; and more]
* Explanation: <explain the error, likely impact, and what to check next>
EOF

# Function: Text prepended to each journal chunk before sending it to the AI.
# Syntax: multi-line text.
prompts.chunk_user_prefix <<EOF
Analyze the following journalctl output chunk. If the chunk contains only harmless warnings, output ok.

EOF

# Function: System prompt for the final report pass.
# Syntax: multi-line text.
prompts.final_system <<EOF
You are a senior Linux/SRE incident analyst.
Create a concise operational report from the chunk analyses.

Rules:
- Use only events mentioned in the chunk analyses.
- Do not invent errors.
- Deduplicate repeated findings.
- Preserve example timestamps when present.
- Prioritize recommendations by urgency.
- Use ASCII only.

Use this structure:

Summary
-------
<short summary>

Priority 1 - Fix soon
---------------------
<actionable items, impact, recommended commands/checks, example timestamps>

Priority 2 - Investigate
------------------------
<important but less urgent items, example timestamps>

Priority 3 - Monitor
--------------------
<items to watch, example timestamps>

Notes
-----
<uncertainties or missing context>
EOF

# Function: User prompt template for the final report pass.
# Syntax: multi-line text. Must contain {chunk_results}.
prompts.final_user_template <<EOF
Create a report with prioritized recommendations from the following AI chunk analyses.

{chunk_results}
EOF

# Function: Default output mode.
# Syntax: errors, report, or all.
defaults.mode = all

# Function: Show progress bar while chunks are analyzed.
# Syntax: true or false.
defaults.progress = true

# Function: Print filtered journal lines before AI analysis.
# Syntax: true or false.
defaults.print_journal = false

# Function: Optional directory for saving chunk results and final report as text files.
# Syntax: empty string or directory path.
defaults.save_dir = ""

# Function: Include example journal timestamps in chunk results and final report.
# Syntax: true or false. Default true for easier later journal searches.
timestamps.enabled = true

# Function: Number of example timestamps requested per error.
# Syntax: positive integer.
timestamps.samples_per_error = 3

# Function: Marker appended when more matching timestamps exist than shown.
# Syntax: short ASCII text.
timestamps.more_marker = and more

# Function: Retry once if the AI says ok but the chunk contains strong error keywords.
# Syntax: true or false.
analysis.retry_ok_on_suspicious = true

# Function: Regex patterns that identify suspicious lines for the safety retry.
# Syntax: regex string. Repeat the key to add more patterns.
analysis.suspicious_regex = (failed|failure|error|critical|alert|emergency|denied|unauthorized|segfault|panic|oom-kill|oom killer|i/o error|read-only file system|dependency failed|authentication failure|failed password|invalid user|degraded|smart.*(fail|error)|ext4-fs error|btrfs error|zfs.*(fail|error))

# Function: Prefix used for the retry prompt when suspicious lines were found.
# Syntax: multi-line text.
analysis.retry_user_prefix <<EOF
The previous answer for this chunk was ok, but the lines below contain high-signal error keywords. Re-analyze carefully. Return ok only if the lines are clearly harmless in context. Otherwise use the required Error/Timestamps/Explanation format.

EOF

# Function: Default recipient for --mail without an address.
# Syntax: empty string or email address.
mail.default_to = ""

# Function: Sender address for report emails.
# Syntax: email address.
mail.from = journal-ai-analyzer@localhost

# Function: Subject line for report emails.
# Syntax: plain text.
mail.subject = Linux journal AI report

# Function: SMTP server hostname or IP address.
# Syntax: hostname or IP.
mail.smtp_server = localhost

# Function: SMTP server port.
# Syntax: integer port, for example 25, 465, 587.
mail.smtp_port = 25

# Function: SMTP username. Empty means no SMTP authentication.
# Syntax: string.
mail.smtp_username = ""

# Function: SMTP password. Empty means no SMTP authentication.
# Syntax: string.
mail.smtp_password = ""

# Function: Use implicit TLS from connection start, usually port 465.
# Syntax: true or false.
mail.use_tls = false

# Function: Use STARTTLS after connecting, usually port 587.
# Syntax: true or false.
mail.use_starttls = false
